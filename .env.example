# .env.example — TEMPLATE. Salin jadi `.env` lalu isi per environment.
# Daftar ini kanonis yang beda antar env HANYA nilainya:
# - laptop dev → DATABASE_URL localhost:5433, CORS localhost:3000
# - CI runner  → DATABASE_URL localhost:5432 (lihat .github/workflows/ci.yml)
# - VPS staging → DATABASE_URL Neon pooler, domain confession-booth.web.id
# JANGAN commit file `.env` asli.

# Public (boleh di-expose ke browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=0xa8302048773DD213B9D311c2abda199B14339188

# Server-only — JANGAN pakai prefix NEXT_PUBLIC_*
DATABASE_URL=postgres://booth:booth@localhost:5432/booth
APP_DOMAIN=booth.local
NODE_ENV=development
SESSION_SECRET=change-me-min-32-chars-in-production
ADMIN_SECRET=change-me-admin-only
ADMIN_WALLETS=
MODERATOR_WALLETS=
CORS_ORIGIN=http://localhost:3000

# Chain Sepolia (opsional di staging; kosong = worker publisher/indexer skip aman)
RPC_URL=https://sepolia.infura.io/v3/CHANGE_ME
RPC_WS_URL=wss://sepolia.infura.io/ws/v3/CHANGE_ME
PUBLISHER_KEY=
DEPLOYER_KEY=

# Storage IPFS Kubo (opsional; kosong = db:inline)
STORAGE_ENDPOINT=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# Hardening (opsional, ada default aman)
REDIS_URL=
POW_DIFFICULTY=14
CAPTCHA_SECRET=

# ZK_MOCK=true mengizinkan stub proof anonim (dev/staging/e2e). PROD WAJIB 'false'
# atau unset sampai verifier Groth16 nyata tersedia — ZK tanpa itu → 503.
ZK_MOCK=false
# Set 'false' setelah bootstrap admin pertama untuk menutup /api/admin/grant-role.
ADMIN_GRANT_ENABLED=true

# Compose + Caddy (VPS API-only; abaikan untuk dev lokal/CI)
POSTGRES_USER=booth
POSTGRES_PASSWORD=booth
POSTGRES_DB=booth
API_DOMAIN=
